<Project>
	<PropertyGroup>
		<!-- Defaults, you can override these -->

		<!-- Assume it's a git submodule -->
		<Sapphire_LocalDirectory Condition="'$(Sapphire_LocalDirectory)' == ''">../Dependencies/Sapphire</Sapphire_LocalDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(Sapphire_LocalDirectory)/Sapphire.csproj" />
	</ItemGroup>
</Project>