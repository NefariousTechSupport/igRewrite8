<Project>
	<PropertyGroup>
		<!-- Defaults, you can override these -->

		<!-- Assume it's a git submodule -->
		<Kovah_LocalDirectory Condition="'$(Kovah_LocalDirectory)' == ''">../Dependencies/Kovah</Kovah_LocalDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(Kovah_LocalDirectory)/Kovah/Kovah.csproj" />
	</ItemGroup>
</Project>
