    <Content Include="bin\Debug\net6.0-windows\igCauldron3.deps.json" />
    <Content Include="bin\Debug\net6.0-windows\igCauldron3.runtimeconfig.json" />
    <DefaultImGuiIni Include="../Resources/defaultimgui.ini" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin\Debug\net6.0-windows\ArkCore\EV_SkylandersImaginators\initscript" />
