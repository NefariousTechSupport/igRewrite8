    <Content Include="bin\Debug\net6.0-windows\ArkCore\EV_SkylandersSuperchargers\metaobjects.xml" />
    <Content Include="bin\Debug\net6.0-windows\ArkCore\EV_SkylandersTrapTeam\metaenums.xml" />
